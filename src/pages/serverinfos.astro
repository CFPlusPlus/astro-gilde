---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import DividerList from '../components/ui/DividerList.astro';
import Section from '../components/ui/Section.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { Image } from 'astro:assets';
import { buildArticle, buildGameServer } from '../lib/structuredData';
import { Cpu, Shield, Gamepad2, Download, Map, ArrowRight } from '@lucide/astro';
import { canonicalFor, site } from '../config/site';
import { minecraftGilde } from '../config/minecraftGilde';
import foliaImage from '../assets/images/tech/folia.webp';

const DISCORD_URL = minecraftGilde.discord.url;
const DYNMAP_URL = minecraftGilde.mapUrl;
const SERVER_IP = minecraftGilde.serverIp;
const MC_VERSION = minecraftGilde.mcVersion;
const FOLIA_IMAGE_WIDTH = 704;
const FOLIA_IMAGE_HEIGHT = Math.round((foliaImage.height / foliaImage.width) * FOLIA_IMAGE_WIDTH);

const canonicalUrl = canonicalFor(Astro.url.pathname);
const gameServerLd = buildGameServer({
  site,
  canonicalUrl,
  ip: SERVER_IP,
  port: 25565,
  version: MC_VERSION,
  maxPlayers: 100,
});

const articleLd = buildArticle({
  site,
  canonicalUrl,
  type: 'TechArticle',
  headline: `Serverinfos & Folia-Setup - Minecraft Gilde (Vanilla SMP ${MC_VERSION})`,
  description:
    `Technische Details zum Setup der Minecraft Gilde: Folia ${MC_VERSION}, Hardware und Kernfeatures - optimiert für Vanilla Survival & Freebuild ohne Pay2Win.`,
  image: new URL(minecraftGilde.brand.logo.path, site).toString(),
  authorName: 'Christian Falkner',
  authorUrl: 'https://www.falkner.info',
  articleSection: 'Serverinformationen',
});
---

<BaseLayout
  title="Minecraft Gilde - Serverinfos"
  canonical={canonicalUrl}
  description={`Serverinfos der Minecraft Gilde – Folia ${MC_VERSION}, Einstellungen, Plugins und Hardware. Vanilla SMP (DE) für Freebuild und Survival ohne Minigames.`}
>
  <JsonLd slot="head" data={gameServerLd} />
  <JsonLd slot="head" data={articleLd} />
  <PageHeader
    title="Serverinfos"
    subtitle="Vanilla Survival & Freebuild - stabil, fair und ohne Resets."
    actionsInline
    headerClass="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    actionsClass="flex flex-wrap gap-2"
  >
    <Fragment slot="actions">
      <Button variant="primary" class="gap-2" data-copy-ip>
        <Download size={18} /> Jetzt Spielen
      </Button>
      <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
        Discord <ArrowRight size={18} />
      </Button>
      <Button href={DYNMAP_URL} external variant="ghost" class="gap-2"
        ><Map size={18} /> Dynmap</Button
      >
    </Fragment>

    <div class="mt-6 flex flex-wrap gap-2">
      <Badge variant="accent">{MC_VERSION}</Badge>
      <Badge>Folia (Paper Fork)</Badge>
      <Badge>Ohne Resets</Badge>
    </div>
  </PageHeader>

  <section class="mg-container pb-16">
    <div
      class="border-border/70 from-surface/40 to-surface/10 rounded-[var(--radius)] border bg-gradient-to-b p-6 sm:p-7"
      data-motion="reveal"
    >
      <div class="grid gap-8 lg:grid-cols-3">
        <section>
          <div class="flex items-start gap-3">
            <Gamepad2 size={20} />
            <h2 class="text-base font-semibold">Kurzprofil</h2>
          </div>
          <dl class="mg-list mt-3 text-sm">
            <div class="mg-row items-center">
              <dt class="text-muted">IP</dt><dd class="font-semibold">{SERVER_IP}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Version</dt><dd>Folia {MC_VERSION}</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Typ</dt><dd>Vanilla SMP (DE)</dd>
            </div>
            <div class="mg-row items-center">
              <dt class="text-muted">Welt</dt><dd>seit Feb 2024</dd>
            </div>
          </dl>
        </section>

        <section>
          <div class="flex items-start gap-3">
            <Cpu size={20} />
            <h2 class="text-base font-semibold">Technik</h2>
          </div>
          <DividerList as="ul" class="mt-3 list-none pl-0 text-sm">
            <li class="mg-row !justify-start">
              <span class="text-fg/90 font-medium">CPU:</span> 2x Intel Xeon E5-2680 v2 (20 Kerne / 40
              Threads)
            </li>
            <li class="mg-row !justify-start">
              <span class="text-fg/90 font-medium">RAM:</span> 128 GB DDR3 ECC
            </li>
            <li class="mg-row !justify-start">
              <span class="text-fg/90 font-medium">Storage:</span> 500 GB SSD
            </li>
            <li class="mg-row !justify-start">
              <span class="text-fg/90 font-medium">OS:</span> Ubuntu 24.04
            </li>
            <li class="mg-row !justify-start">
              <span class="text-fg/90 font-medium">DB:</span> MariaDB (für Statistiken)
            </li>
            <li class="mg-row !justify-start">
              <span class="text-fg/90 font-medium">GC:</span> G1GC
            </li>
          </DividerList>
        </section>

        <section>
          <div class="flex items-start gap-3">
            <Shield size={20} />
            <h2 class="text-base font-semibold">Gameplay &amp; Schutz</h2>
          </div>
          <DividerList as="ul" class="text-muted mt-3 list-none pl-0 text-sm">
            <li class="mg-row !justify-start">16 Chunks Sichtweite</li>
            <li class="mg-row !justify-start">Vanilla-nahe Spawnraten</li>
            <li class="mg-row !justify-start">
              Keine künstlichen Einschränkungen bei Mobs, Villagern oder Farmen
            </li>
            <li class="mg-row !justify-start">
              Grundstücke lassen sich selbst schützen (GriefPrevention)
            </li>
            <li class="mg-row !justify-start">Keine kaufbaren Ränge oder Items</li>
          </DividerList>
          <div class="mt-4 flex flex-wrap gap-2">
            <Button href="/tutorial" variant="secondary">Tutorial</Button>
            <Button href="/regeln" variant="ghost">Regeln</Button>
          </div>
        </section>
      </div>
    </div>

    <Section
      tone="muted"
      container={false}
      padded={false}
      class="mt-6 rounded-[var(--radius)] p-6 sm:p-7"
    >
      <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-start" data-motion-stagger="90">
        <article data-motion="reveal">
          <h2 class="text-xl font-semibold tracking-tight">Warum Folia?</h2>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            Seit Mai 2025 läuft der Server auf Folia - einem Paper-Fork, der die Welt in Regionen
            aufteilt und parallel verarbeitet. Das sorgt vor allem dann für mehr Stabilität, wenn
            viele Spieler gleichzeitig online sind.
          </p>
          <p class="text-muted mt-3 text-sm leading-relaxed">
            Im Alltag funktioniert das Setup inzwischen sehr zuverlässig. Einzelne Plugins machen
            selten noch Probleme, insgesamt läuft Folia aber stabil und praxisnah.
          </p>
        </article>

        <figure class="lg:border-border/55 lg:border-l lg:pl-7" data-motion="reveal">
          <Image
            src={foliaImage}
            alt="Folia Logo"
            width={FOLIA_IMAGE_WIDTH}
            height={FOLIA_IMAGE_HEIGHT}
            loading="lazy"
            class="mx-auto w-full max-w-[18rem] sm:max-w-[20rem] md:max-w-[22rem]"
          />
          <figcaption class="text-muted mt-4 text-center text-sm">
            Folia ist ein Fork von PaperMC und setzt auf einen Multithreaded-Ansatz.
          </figcaption>
        </figure>
      </div>

      <div class="border-border/60 mt-6 border-t pt-6" data-motion="reveal">
        <p class="text-sm leading-relaxed">
          Du willst direkt loslegen? Dann schau kurz ins Tutorial - dort findest du Claim, RTP,
          Rollen und alles Wichtige.
        </p>
        <div class="mt-3">
          <Button href="/tutorial" variant="primary">Zum Tutorial</Button>
        </div>
      </div>
    </Section>
  </section>
</BaseLayout>

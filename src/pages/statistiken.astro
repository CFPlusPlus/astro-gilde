---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import StatsApp from '../features/stats/StatsApp';
import { canonicalFor } from '../config/site';

const statsCanonicalUrl = canonicalFor('/statistiken/');
---

<BaseLayout
  title="Minecraft Gilde - Statistiken"
  canonical={statsCanonicalUrl}
  description="Live-Spielerstatistiken für Minecraft Gilde - Ranglisten, Server-König und Spielerübersicht."
>
  <!-- Performance: Avatar-CDN früh auflösen -->
  <link slot="head" rel="preconnect" href="https://minotar.net" crossorigin />
  <link slot="head" rel="dns-prefetch" href="//minotar.net" />

  <PageHeader
    title="Statistiken"
    subtitle="Suche nach Spielern, entdecke Ranglisten und sieh, wer aktuell die meisten Punkte sammelt. Die Daten werden serverseitig erzeugt und können leicht verzögert sein."
    subtitleClass="text-muted mt-2 max-w-3xl"
  />

  <div
    id="stats-overview-placeholder"
    aria-hidden="true"
    class="space-y-6 transition-opacity duration-200"
  >
    <section class="mg-surface-1">
      <div class="mg-container py-8">
        <div class="space-y-3">
          <div class="bg-surface-solid/70 h-9 w-full max-w-xl rounded-lg"></div>
          <div class="bg-surface-solid/55 h-4 w-full max-w-md rounded-lg"></div>
        </div>
      </div>
    </section>

    <section class="mg-container py-8">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
        <div class="mg-surface-2 min-h-[12rem] lg:col-span-4"></div>
        <div class="mg-surface-2 min-h-[22rem] lg:col-span-8"></div>
      </div>
    </section>
  </div>

  <!-- React-Island: lädt die interaktive Statistik-App -->
  <StatsApp client:idle />
</BaseLayout>

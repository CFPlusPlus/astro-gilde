---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlayerStatsApp from '../../features/player-stats/PlayerStatsApp';
import { canonicalFor } from '../../config/site';

const statsCanonicalUrl = canonicalFor('/statistiken/');
---

<BaseLayout
  title="Minecraft Gilde - Spielerstatistik"
  canonical={statsCanonicalUrl}
  noindex={true}
  description="Spielerstatistiken für Minecraft Gilde – Werte, Items und Kreaturen nach Spieler."
>
  <link slot="head" rel="preconnect" href="https://minotar.net" crossorigin />
  <link slot="head" rel="dns-prefetch" href="//minotar.net" />
  <link slot="head" rel="preconnect" href="https://mc-heads.net" crossorigin />
  <link slot="head" rel="dns-prefetch" href="//mc-heads.net" />
  <link slot="head" rel="preconnect" href="https://api.minetools.eu" crossorigin />
  <link slot="head" rel="preconnect" href="https://textures.minecraft.net" crossorigin />

  <PlayerStatsApp client:load />
</BaseLayout>

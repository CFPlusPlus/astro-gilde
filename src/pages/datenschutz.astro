---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { ArrowRight } from '@lucide/astro';
import datenschutzHtml from '../partials/datenschutz.html?raw';
import { minecraftGilde } from '../config/minecraftGilde';

const DISCORD_URL = minecraftGilde.discord.url;
---

<BaseLayout
  title="Minecraft Gilde - Datenschutz"
  description="Datenschutzerklärung der Minecraft Gilde mit Informationen zur Verarbeitung personenbezogener Daten auf Website und Minecraft-Server."
>
  <PageHeader title="Datenschutz" subtitle="Datenschutzerklärung für Website & Minecraft-Server.">
    <Fragment slot="actions">
      <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
        Discord <ArrowRight size={18} />
      </Button>
      <Button href="/impressum" variant="secondary">Impressum</Button>
    </Fragment>
  </PageHeader>

  <section class="mg-container pb-16">
    <Card class="p-6">
      <div class="mg-prose" set:html={datenschutzHtml} />
    </Card>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import DividerList from '../components/ui/DividerList.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { ArrowRight, Users } from '@lucide/astro';
import { Image } from 'astro:assets';
import { minecraftGilde } from '../config/minecraftGilde';
import partnerAckImage from '../assets/images/partner/ack.webp';

const PARTNER_URL = 'https://www.anti-corona-kartell.de';
const PARTNER_DISCORD_URL = 'https://discord.anti-corona-kartell.de';
const DISCORD_URL = minecraftGilde.discord.url;
const PARTNER_ACK_WIDTH = 640;
const PARTNER_ACK_HEIGHT = Math.round(
  (partnerAckImage.height / partnerAckImage.width) * PARTNER_ACK_WIDTH,
);
---

<BaseLayout
  title="Minecraft Gilde – Partner"
  description="Community-Partner der Minecraft Gilde – befreundete Communities und Projekte."
>
  <PageHeader
    title="Partner"
    subtitle="Hier findest du befreundete Communities und Projekte, mit denen wir eng zusammenarbeiten."
    class="pb-10"
    headerClass="max-w-3xl"
    subtitleClass="text-muted mt-3"
  >
    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]" data-motion-stagger="90">
      <section data-motion="reveal">
        <div
          class="mg-card mg-card--soft mg-mesh-bg mg-noise relative isolate flex items-center justify-center overflow-hidden p-5 sm:p-6"
        >
          <Image
            src={partnerAckImage}
            alt="ANTI-CORONA-KARTELL"
            width={PARTNER_ACK_WIDTH}
            height={PARTNER_ACK_HEIGHT}
            loading="lazy"
            decoding="async"
            class="relative z-10 aspect-square w-full max-w-[210px] object-contain drop-shadow-[0_14px_34px_rgba(0,0,0,0.45)] [backface-visibility:hidden]"
          />
        </div>
        <div class="pt-6 sm:pt-7">
          <h2 class="text-xl font-semibold">ANTI-CORONA-KARTELL</h2>
          <p class="text-muted mt-2 text-sm">
            Seit April 2024 ist die Minecraft Gilde Partner des ANTI-CORONA-KARTELL - einer aktiven
            Gaming-Community mit eigenen Projekten und mehreren Games.
          </p>
          <p class="text-muted mt-3 text-sm">
            Aus der Partnerschaft entstehen regelmäßig gemeinsame Events, Spielsessions und lockere
            Treffen. Wenn du neue Mitspieler suchst oder einfach Lust auf Austausch hast, lohnt sich
            ein Blick auf jeden Fall.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <Button href={PARTNER_URL} external variant="primary" class="gap-2">
              Zur Community <ArrowRight size={18} />
            </Button>
            <Button href={PARTNER_DISCORD_URL} external variant="secondary" class="gap-2">
              Unser Discord <Users size={18} />
            </Button>
          </div>
        </div>
      </section>

      <aside class="lg:border-border/70 pt-1 lg:border-l lg:pl-6" data-motion="reveal">
        <h2 class="text-xl font-semibold">Partner werden?</h2>
        <p class="text-muted mt-2 text-sm">
          Du möchtest mit uns kooperieren oder ein eigenes Projekt vorstellen? Dann schreib uns
          gerne auf Discord.
        </p>
        <DividerList as="ul" class="mt-4 list-none pl-0 text-left">
          <li class="mg-row !justify-start gap-3 py-3 text-left text-sm">
            <span aria-hidden="true" class="bg-accent mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
            ></span>
            <span class="text-muted">Freundlicher Umgang & klare Regeln</span>
          </li>
          <li class="mg-row !justify-start gap-3 py-3 text-left text-sm">
            <span aria-hidden="true" class="bg-accent mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
            ></span>
            <span class="text-muted">Community- und Projekt-Fokus (keine Werbung/Spam)</span>
          </li>
          <li class="mg-row !justify-start gap-3 py-3 text-left text-sm">
            <span aria-hidden="true" class="bg-accent mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full"
            ></span>
            <span class="text-muted">Transparente Zusammenarbeit</span>
          </li>
        </DividerList>
        <div class="mt-5">
          <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
            Kontakt auf Discord <ArrowRight size={18} />
          </Button>
        </div>
      </aside>
    </div>
  </PageHeader>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { ArrowRight, Users } from '@lucide/astro';
import { minecraftGilde } from '../config/minecraftGilde';

const PARTNER_URL = 'https://www.anti-corona-kartell.de';
const DISCORD_URL = minecraftGilde.discord.url;
---

<BaseLayout
  title="Minecraft Gilde – Partner"
  description="Community-Partner von Minecraft Gilde – befreundete Communities und Projekte."
>
  <section class="mg-container pt-12 pb-10">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight">Partner</h1>
      <p class="text-muted mt-3">
        Hier findest du befreundete Communities und Projekte, mit denen wir zusammenarbeiten.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="glass overflow-hidden rounded-[28px]">
        <div class="flex items-center justify-center bg-black/10 p-5 sm:p-6">
          <img
            src="/images/ack.png"
            alt="ANTI-CORONA-KARTELL"
            loading="lazy"
            decoding="async"
            class="aspect-square w-full max-w-[320px] object-contain"
          />
        </div>
        <div class="p-6 sm:p-7">
          <h2 class="text-xl font-semibold">ANTI-CORONA-KARTELL</h2>
          <p class="text-muted mt-2 text-sm">
            Seit April 2024 ist die Minecraft Gilde stolzer Partner des ANTI-CORONA-KARTELL - einer
            engagierten, jungen Gaming-Community, die verschiedene Spiele spielt und eigene
            Game-Server betreibt.
          </p>
          <p class="text-muted mt-3 text-sm">
            Durch die Partnerschaft finden regelmäßig Community-Events, Spielsessions und entspannte
            Treffen statt, bei denen du neue Mitspieler*innen kennenlernen kannst. Ob im Spiel oder
            im Voice-Chat: Teamgeist und Miteinander stehen immer im Mittelpunkt. Neugierig
            geworden? Dann schau vorbei und werde Teil einer aktiven, freundlichen Community.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <Button href={PARTNER_URL} external variant="primary" class="gap-2">
              Zur Community <ArrowRight size={18} />
            </Button>
            <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
              Unser Discord <Users size={18} />
            </Button>
          </div>
        </div>
      </div>

      <div class="glass rounded-[28px] p-6 sm:p-7">
        <h2 class="text-xl font-semibold">Partner werden?</h2>
        <p class="text-muted mt-2 text-sm">
          Du möchtest mit uns kooperieren oder ein Projekt vorstellen? Schreib uns einfach auf
          Discord.
        </p>
        <ul class="text-muted mt-4 space-y-2 text-sm">
          <li>• Freundlicher Umgang & klare Regeln</li>
          <li>• Community-/Projekt-Fokus (keine Werbung/Spam)</li>
          <li>• Transparente Zusammenarbeit</li>
        </ul>
        <div class="mt-5">
          <Button href={DISCORD_URL} external variant="secondary" class="gap-2">
            Kontakt auf Discord <ArrowRight size={18} />
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

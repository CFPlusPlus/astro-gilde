---
import HomeQuickNav from './HomeQuickNav.astro';

import HomeHero from './sections/HomeHero.astro';
import HomeUsps from './sections/HomeUsps.astro';
import HomeAbout from './sections/HomeAbout.astro';
import HomeVanillaPlus from './sections/HomeVanillaPlus.astro';
import HomeStartSteps from './sections/HomeStartSteps.astro';
import HomeLive from './sections/HomeLive.astro';
import HomeSupport from './sections/HomeSupport.astro';
import HomeQuickLinks from './sections/HomeQuickLinks.astro';
import HomeJoinCta from './sections/HomeJoinCta.astro';

import { homeAlert } from '../../data/homeAlert';
import type { ImageMetadata } from 'astro';
import type { AnchorItem } from './HomeQuickNav.astro';

export interface Props {
  anchorItems: AnchorItem[];
  galleryUrls: string[];
  galleryInitialImage: ImageMetadata;
}

const { anchorItems, galleryUrls, galleryInitialImage } = Astro.props as Props;
---

<div data-home>
  <HomeHero alert={homeAlert} />

  <div class="mt-3 mb-2" data-motion="reveal" data-motion-delay="60">
    <HomeQuickNav items={anchorItems} />
  </div>

  <HomeUsps />
  <HomeAbout galleryUrls={galleryUrls} galleryInitialImage={galleryInitialImage} />
  <HomeVanillaPlus />
  <HomeStartSteps />
  <HomeLive />
  <HomeSupport />
  <HomeQuickLinks />
  <HomeJoinCta />
</div>

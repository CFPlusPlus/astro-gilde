---
import Button from '../../ui/Button.astro';
import IconButton from '../../ui/IconButton.astro';
import Badge from '../../ui/Badge.astro';
import HomeSection from '../HomeSection.astro';
import { Image } from 'astro:assets';

import { minecraftGilde } from '../../../config/minecraftGilde';
import { Activity, ArrowRight, Check, Download, Map, Users } from '@lucide/astro';
import headerBackgroundImage from '../../../assets/images/home/header-background.webp';
import logoBigImage from '../../../assets/images/branding/logo-big.webp';

const DISCORD_URL = minecraftGilde.discord.url;
const DYNMAP_URL = minecraftGilde.mapUrl;
const STATUS_URL = minecraftGilde.statusUrl;
const SERVER_IP = minecraftGilde.serverIp;
const MC_VERSION = minecraftGilde.mcVersion;

const HERO_BACKGROUND_WIDTH = 1920;
const HERO_BACKGROUND_HEIGHT = Math.round(
  (headerBackgroundImage.height / headerBackgroundImage.width) * HERO_BACKGROUND_WIDTH,
);
const HERO_BACKGROUND_WIDTHS = [640, 960, 1280, 1600, HERO_BACKGROUND_WIDTH];
const HERO_BACKGROUND_SIZES = '100vw';
---

<!--
  Der Hero-Hintergrund wird nach oben verlängert, damit er unter der Navbar sauber abschließt,
  ohne das Layout nach oben zu ziehen oder JavaScript zu benötigen.
-->
<section
  class="home-hero relative pt-24 pb-24 sm:pt-36 sm:pb-36 lg:pt-44 lg:pb-44 xl:pt-48 xl:pb-48"
>
  <div class="home-hero-bg mg-mesh-bg mg-noise pointer-events-none absolute inset-x-0 bottom-0 z-0">
    <Image
      src={headerBackgroundImage}
      alt=""
      width={HERO_BACKGROUND_WIDTH}
      height={HERO_BACKGROUND_HEIGHT}
      widths={HERO_BACKGROUND_WIDTHS}
      sizes={HERO_BACKGROUND_SIZES}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full [mask-image:radial-gradient(100%_86%_at_50%_28%,black_0%,black_66%,transparent_100%)] object-cover object-[center_18%] opacity-20"
    />
    <div class="from-bg/3 via-bg/44 to-bg absolute inset-0 bg-gradient-to-b via-72%"></div>
  </div>

  <div class="mg-container relative z-10">
    <div class="grid items-center gap-10 sm:gap-14 lg:grid-cols-[1.12fr_0.88fr] lg:gap-24">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl" data-motion="reveal">
          Minecraft Gilde
        </h1>
        <p
          class="text-muted mt-6 max-w-2xl text-base leading-relaxed sm:text-lg"
          data-motion="reveal"
          data-motion-delay="80"
        >
          Hier spielst du auf einer Langzeitwelt ohne Reset-Druck: fair ohne Pay-to-Win und mit
          Vanilla+-Komfort, der dir den Alltag leichter macht.
        </p>

        <div
          class="mt-10 grid max-w-md grid-cols-2 items-center gap-3 sm:mt-12 sm:flex sm:max-w-none sm:flex-wrap"
          data-motion="reveal"
          data-motion-delay="140"
        >
          <Button
            variant="primary"
            class="col-span-2 w-full justify-center gap-2 sm:w-auto"
            data-copy-ip
          >
            <Download size={18} /> Jetzt Spielen
          </Button>
          <Button
            href={DISCORD_URL}
            external
            variant="secondary"
            class="w-full justify-center gap-2 sm:w-auto"
          >
            Discord <ArrowRight size={18} />
          </Button>
          <Button
            href="/tutorial"
            variant="secondary"
            class="w-full justify-center gap-2 sm:w-auto"
          >
            Tutorial
          </Button>
        </div>

        <p class="text-muted mt-8 text-sm" data-motion="reveal" data-motion-delay="200">
          Kein Minigame-Loop, kein Citybuild-Zwang - bei uns stehen Survival, Freebuild und
          Gemeinschaft im Mittelpunkt.
        </p>

        <div
          class="mt-10 flex flex-wrap items-center gap-2 sm:mt-12"
          data-motion="reveal"
          data-motion-delay="260"
        >
          <Badge variant="accent">Vanilla+</Badge>
          <Badge>Langzeitwelt</Badge>
          <Badge>Kein P2W</Badge>
          <Badge>Java {MC_VERSION}</Badge>
        </div>
      </div>

      <div
        class="relative mt-2 sm:mt-4 lg:mt-0"
        data-motion="reveal"
        data-motion-direction="right"
        data-motion-delay="140"
      >
        <img
          src={logoBigImage.src}
          width={logoBigImage.width}
          height={logoBigImage.height}
          alt="Minecraft Gilde Logo"
          decoding="async"
          class="mx-auto w-[min(360px,78vw)] opacity-95 drop-shadow-[0_24px_60px_rgba(0,0,0,0.32)] select-none sm:w-[min(440px,88%)] lg:w-[min(520px,95%)]"
        />
      </div>
    </div>
  </div>
</section>

<!-- Join-Bar (aus dem Hero ausgelagert, damit der Hero luftiger und weniger überladen wirkt) -->
<HomeSection size="tight" containerClass="pt-0">
  <div
    class="mg-card mg-card--soft relative overflow-hidden px-4 py-6 sm:px-6 sm:py-7"
    data-motion="reveal"
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[color:var(--accent)]/55 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div
        class="grid w-full items-center gap-y-3 sm:grid-cols-[minmax(16rem,1.1fr)_minmax(10rem,0.6fr)_minmax(16rem,1fr)] sm:gap-y-0"
      >
        <div class="px-3 py-2 sm:px-5">
          <div class="text-muted text-[0.68rem] font-semibold tracking-[0.14em] uppercase">
            Server-IP
          </div>
          <div class="mt-1.5 flex items-center gap-2">
            <button
              type="button"
              class="focus-visible:ring-offset-bg border-border/70 bg-surface-solid/24 text-fg hover:border-accent/60 inline-flex h-10 min-w-[13rem] items-center justify-center rounded-lg border px-3.5 font-mono text-[0.95rem] font-semibold tracking-[0.01em] transition-colors hover:bg-[color:var(--accent-soft)] focus-visible:ring-2 focus-visible:ring-[color:var(--ring)] focus-visible:ring-offset-2 sm:justify-start"
              aria-label="Server-IP kopieren"
              data-copy-ip-inline
            >
              <span class="relative inline-flex items-center justify-center">
                <span
                  class="font-mono transition-opacity duration-150"
                  data-copy-ip-inline-label-default
                >
                  {SERVER_IP}
                </span>
                <span
                  class="pointer-events-none absolute inset-0 inline-flex items-center justify-center gap-1.5 opacity-0 transition-opacity duration-150"
                  data-copy-ip-inline-label-success
                  aria-hidden="true"
                >
                  <Check size={14} />
                  <span>IP kopiert</span>
                </span>
              </span>
            </button>
            <IconButton
              ariaLabel="Jetzt spielen"
              variant="ghost"
              class="hover:border-accent/60 duration-200 hover:bg-[var(--accent-soft)]"
              data-copy-ip
            >
              <Download size={16} />
            </IconButton>
          </div>
        </div>

        <div class="sm:border-border/60 px-3 py-2 sm:border-x sm:px-5">
          <div class="text-muted text-[0.68rem] font-semibold tracking-[0.14em] uppercase">
            Version
          </div>
          <div class="mt-1 text-base font-semibold tracking-tight">Java {MC_VERSION}</div>
        </div>

        <div class="px-3 py-2 sm:px-5">
          <div class="text-muted text-[0.68rem] font-semibold tracking-[0.14em] uppercase">
            Live
          </div>
          <div class="mt-1 flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
            <span class="inline-flex items-center gap-2">
              <Users size={16} />
              <span class="font-semibold" data-mc-online>0</span>
              <span class="text-muted">Minecraft</span>
            </span>
            <span class="inline-flex items-center gap-2">
              <Users size={16} />
              <span class="font-semibold" data-discord-online>0</span>
              <span class="text-muted">Discord</span>
            </span>
          </div>
        </div>
      </div>

      <div class="border-border/60 flex flex-wrap gap-2 pt-2 lg:border-l lg:pt-0 lg:pl-5">
        <Button href={DYNMAP_URL} external variant="secondary" size="sm" class="gap-2">
          <Map size={16} /> Karte
        </Button>
        <Button href={STATUS_URL} external variant="secondary" size="sm" class="gap-2">
          <Activity size={16} /> Status
        </Button>
      </div>
    </div>
  </div>
</HomeSection>

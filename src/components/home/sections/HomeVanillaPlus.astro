---
import Button from '../../ui/Button.astro';
import HomeSection from '../HomeSection.astro';
import { ArrowRight, Cpu, House, Map, Shield, Sparkles, Wand } from '@lucide/astro';
---

<HomeSection id="vanilla" size="normal" tone="muted">
  <div class="relative">
    <div
      class="bg-accent/6 pointer-events-none absolute -inset-x-6 -top-8 -bottom-8 -z-10 rounded-[32px] blur-2xl"
      aria-hidden="true"
    >
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <h2 class="text-3xl font-semibold tracking-tight">Vanilla+ - genau das richtige Maß</h2>
        <p class="text-muted mt-3 max-w-2xl">
          Hilfreiche Funktionen, die dir den Einstieg erleichtern, ohne den Kern von Survival zu
          verändern.
        </p>
      </div>
      <Button href="/tutorial" variant="secondary" class="gap-2">
        Tutorial ansehen <ArrowRight size={18} />
      </Button>
    </div>

    <div class="mt-10" data-reveal data-reveal-delay="100">
      <div class="grid gap-7 md:grid-cols-2">
        <div class="flex gap-4">
          <div
            class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border"
          >
            <Shield size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Claims / Grief-Schutz</h3>
            <p class="text-muted mt-1 text-sm">Dein Gebiet bleibt geschützt und in deiner Hand.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div
            class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border"
          >
            <Map size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Farmwelten</h3>
            <p class="text-muted mt-1 text-sm">
              Ressourcen sammeln, ohne die Hauptwelt dauerhaft zu verändern.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div
            class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border"
          >
            <House size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Bis zu 20 Homes</h3>
            <p class="text-muted mt-1 text-sm">
              Komme schnell zu deinen Projekten zurück - ohne Umwege.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div
            class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border"
          >
            <Wand size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">/RTP</h3>
            <p class="text-muted mt-1 text-sm">Finde in wenigen Sekunden einen guten Startpunkt.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div
            class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border"
          >
            <Sparkles size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Quality-of-Life</h3>
            <p class="text-muted mt-1 text-sm">
              Spürbar angenehmer spielen - ohne modded Overkill.
            </p>
          </div>
        </div>

        <div class="flex gap-4">
          <div
            class="bg-accent/15 border-accent/25 inline-flex size-11 shrink-0 items-center justify-center rounded-xl border"
          >
            <Cpu size={18} />
          </div>
          <div>
            <h3 class="text-base font-semibold">Stabil & performant</h3>
            <p class="text-muted mt-1 text-sm">
              Flüssiges Spielen, auch wenn auf dem Server viel los ist.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</HomeSection>

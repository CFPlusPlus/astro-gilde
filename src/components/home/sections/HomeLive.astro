---
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import { Map, Users } from '@lucide/astro';

const DYNMAP_URL = minecraftGilde.mapUrl;
---

<HomeSection id="live" size="normal" tone="muted" variant="panel">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
    <div>
      <h2 class="text-3xl font-semibold tracking-tight">Live auf dem Server</h2>
      <p class="text-muted mt-3 max-w-2xl">
        Schau nach, wer gerade online ist und wie lange unsere Hauptwelt schon läuft.
      </p>
    </div>
  </div>

  <div class="mt-10 grid gap-4 lg:grid-cols-12">
    <article
      class="bg-surface-solid/35 border-border/72 flex h-full flex-col rounded-xl border p-5 sm:p-6 lg:col-span-7"
      data-reveal
      data-reveal-delay="100"
    >
      <div class="flex items-center justify-between gap-3">
        <h3 class="text-base font-semibold">Spieler online</h3>
        <span class="text-muted text-xs">Live</span>
      </div>
      <div class="mt-4 min-h-14" id="player-list">
        <p class="text-muted text-sm">Lade Spieler…</p>
      </div>
      <p class="text-muted mt-4 text-xs">
        Tipp: Klicke auf einen Namen, um die Spielerstatistik zu öffnen.
      </p>
    </article>

    <div class="grid gap-3 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
      <article class="mg-card mg-card--outlined p-4 sm:p-5" data-reveal data-reveal-delay="140">
        <h3 class="text-base font-semibold">Status</h3>
        <div class="mt-3 grid gap-2">
          <div
            class="border-border bg-surface/45 flex items-center justify-between rounded-lg border px-3 py-2.5"
          >
            <span class="inline-flex items-center gap-2 text-sm"><Users size={16} /> Minecraft</span
            >
            <span class="text-sm font-semibold" data-mc-online>Keine</span>
          </div>
          <div
            class="border-border bg-surface/45 flex items-center justify-between rounded-lg border px-3 py-2.5"
          >
            <span class="inline-flex items-center gap-2 text-sm"><Users size={16} /> Discord</span>
            <span class="text-sm font-semibold" data-discord-online>Keine</span>
          </div>
        </div>
      </article>

      <article class="mg-card mg-card--outlined p-4 sm:p-5" data-reveal data-reveal-delay="200">
        <h3 class="text-base font-semibold">Hauptwelt & Karte</h3>
        <p class="text-muted mt-2 text-sm">
          Hauptwelt aktiv: <span class="text-fg font-semibold" id="world-age">-</span>
        </p>
        <p class="text-muted mt-1 text-xs">(seit Feb 2024)</p>
        <a
          href={DYNMAP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mg-link mt-4 inline-flex items-center gap-2 text-sm font-semibold"
        >
          <Map size={16} /> Dynmap öffnen
        </a>
      </article>
    </div>
  </div>
</HomeSection>

---
import HomeSection from '../HomeSection.astro';
import { minecraftGilde } from '../../../config/minecraftGilde';
import {
  ArrowRight,
  BadgeCheck,
  Book,
  ChartColumn,
  CircleQuestionMark,
  Handshake,
  Map,
  Server,
  SquareTerminal,
  Users,
} from '@lucide/astro';

const DYNMAP_URL = minecraftGilde.mapUrl;
---

<HomeSection id="links" size="normal" variant="panel">
  <div data-reveal>
    <h2 class="text-2xl font-semibold tracking-tight">Mehr entdecken</h2>
    <p class="text-muted mt-3 max-w-2xl text-sm">
      Wenn du tiefer einsteigen willst, findest du hier die wichtigsten Seiten auf einen Blick.
    </p>
  </div>

  <div class="mt-8 grid gap-4 lg:grid-cols-12">
    <article
      class="mg-surface-2 relative overflow-hidden p-5 sm:p-6 lg:col-span-5"
      data-reveal
      data-reveal-delay="80"
    >
      <div
        class="bg-accent/10 pointer-events-none absolute -top-16 -right-16 h-40 w-40 rounded-full blur-2xl"
        aria-hidden="true"
      >
      </div>
      <h3 class="text-base font-semibold">Start & Orientierung</h3>
      <p class="text-muted mt-2 text-sm">
        Alles fuer den schnellen Einstieg: Serverdaten, Karte und deine ersten Statistiken.
      </p>

      <div class="mt-4 grid gap-2">
        <a
          href="/serverinfos/"
          class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-start justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
        >
          <span class="flex items-start gap-3">
            <span
              class="bg-accent/15 border-accent/25 text-accent mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg border"
            >
              <Server size={15} />
            </span>
            <span>
              <span class="block text-sm font-semibold">Serverinfos</span>
              <span class="text-muted block text-xs">Version, Technik und wichtige Hinweise.</span>
            </span>
          </span>
          <ArrowRight
            class="text-muted group-hover:text-fg mt-0.5 h-4 w-4 shrink-0 transition-colors"
          />
        </a>

        <a
          href={DYNMAP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-start justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
        >
          <span class="flex items-start gap-3">
            <span
              class="bg-accent/15 border-accent/25 text-accent mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg border"
            >
              <Map size={15} />
            </span>
            <span>
              <span class="block text-sm font-semibold">Karte</span>
              <span class="text-muted block text-xs"
                >Live auf die Welt schauen und Orte finden.</span
              >
            </span>
          </span>
          <ArrowRight
            class="text-muted group-hover:text-fg mt-0.5 h-4 w-4 shrink-0 transition-colors"
          />
        </a>

        <a
          href="/statistiken/"
          class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-start justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
        >
          <span class="flex items-start gap-3">
            <span
              class="bg-accent/15 border-accent/25 text-accent mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg border"
            >
              <ChartColumn size={15} />
            </span>
            <span>
              <span class="block text-sm font-semibold">Statistiken</span>
              <span class="text-muted block text-xs"
                >Rankings, Metriken und Spielerwerte im Blick.</span
              >
            </span>
          </span>
          <ArrowRight
            class="text-muted group-hover:text-fg mt-0.5 h-4 w-4 shrink-0 transition-colors"
          />
        </a>
      </div>
    </article>

    <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
      <article class="mg-card p-5" data-reveal data-reveal-delay="120">
        <h3 class="text-base font-semibold">Wissen & Regeln</h3>
        <p class="text-muted mt-2 text-sm">
          Schnell Antworten finden und die wichtigsten Abläufe verstehen.
        </p>

        <div class="mt-4 grid gap-2">
          <a
            href="/regeln/"
            class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-center justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
          >
            <span class="inline-flex items-center gap-2 text-sm font-medium">
              <Book size={15} /> Regeln
            </span>
            <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
          </a>
          <a
            href="/befehle/"
            class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-center justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
          >
            <span class="inline-flex items-center gap-2 text-sm font-medium">
              <SquareTerminal size={15} /> Befehle
            </span>
            <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
          </a>
          <a
            href="/faq/"
            class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-center justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
          >
            <span class="inline-flex items-center gap-2 text-sm font-medium">
              <CircleQuestionMark size={15} /> FAQ
            </span>
            <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
          </a>
        </div>
      </article>

      <article class="mg-card p-5" data-reveal data-reveal-delay="160">
        <h3 class="text-base font-semibold">Community</h3>
        <p class="text-muted mt-2 text-sm">Team, Votes und Partner auf einen Blick.</p>

        <div class="mt-4 grid gap-2">
          <a
            href="/voten/"
            class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-center justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
          >
            <span class="inline-flex items-center gap-2 text-sm font-medium">
              <BadgeCheck size={15} /> Voten
            </span>
            <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
          </a>
          <a
            href="/team/"
            class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-center justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
          >
            <span class="inline-flex items-center gap-2 text-sm font-medium">
              <Users size={15} /> Team
            </span>
            <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
          </a>
          <a
            href="/partner/"
            class="border-border/75 hover:border-accent/40 hover:bg-surface group flex items-center justify-between gap-3 rounded-xl border px-3.5 py-3 transition-colors"
          >
            <span class="inline-flex items-center gap-2 text-sm font-medium">
              <Handshake size={15} /> Partner
            </span>
            <ArrowRight class="text-muted group-hover:text-fg h-4 w-4 shrink-0 transition-colors" />
          </a>
        </div>
      </article>
    </div>
  </div>
</HomeSection>

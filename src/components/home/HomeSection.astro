---
import Section, { type SectionTone, type SectionVariant } from '../ui/Section.astro';

export type HomeSectionSize = 'tight' | 'normal' | 'loose';

export interface Props {
  /** Optionales Anker-Target (fuer Onepager-Navigation) */
  id?: string;
  /** Zusaetzliche Klassen fuer das <section> */
  class?: string;
  /** Zusaetzliche Klassen fuer den Container */
  containerClass?: string;
  /** Optionaler Trenner (Border oben) */
  divider?: boolean;
  /** Vertikales Spacing-Preset */
  size?: HomeSectionSize;
  /** Optionales Hintergrund-Band */
  tone?: SectionTone;
  /** Optionaler Section-Panelskin (Layout, keine Content-Card) */
  variant?: SectionVariant;
}

const {
  id,
  class: className = '',
  containerClass = '',
  divider = false,
  size = 'normal',
  tone = 'default',
  variant,
  ...rest
} = Astro.props as Props & Record<string, unknown>;

const sizes: Record<HomeSectionSize, string> = {
  // Mehr Luft: groessere Standard-Abstaende fuer eine ruhigere Startseite.
  tight: 'py-14 sm:py-16',
  normal: 'py-24 sm:py-28 lg:py-32',
  loose: 'py-28 sm:py-32 lg:py-36',
};

const sectionClass = `${divider ? 'border-border/70 border-t' : ''} ${className}`.trim();
const container = `${sizes[size]} ${containerClass}`.trim();
---

<Section
  id={id}
  tone={tone}
  variant={variant}
  class={sectionClass}
  container
  padded={false}
  containerClass={container}
  data-section
  {...rest}
>
  <slot />
</Section>

---
import {
  Menu,
  X,
  ExternalLink,
  Sun,
  Moon,
  SunMoon,
  House,
  GraduationCap,
  ScrollText,
  ChartColumn,
  Vote,
  Users,
  Server,
  SquareTerminal,
  CircleQuestionMark,
  BookOpen,
  Activity,
  Map as MapIcon,
  Handshake,
  ShieldCheck,
  FileText,
} from '@lucide/astro';
import Button from './ui/Button.astro';
import IconButton from './ui/IconButton.astro';
import NavItem from './nav/NavItem.astro';
import {
  NAV_DISCORD_LINK,
  NAV_MEGA_MENU_SECTIONS,
  NAV_PRIMARY_LINKS,
  type NavMenuIcon,
} from '../data/nav';
import { appRoutes } from '../config/routes';
import { hrefFor } from '../lib/links';
import logoImage from '../assets/images/branding/logo.webp';

const MENU_ICONS: Record<NavMenuIcon, typeof House> = {
  home: House,
  tutorial: GraduationCap,
  rules: ScrollText,
  stats: ChartColumn,
  vote: Vote,
  team: Users,
  server: Server,
  commands: SquareTerminal,
  faq: CircleQuestionMark,
  history: BookOpen,
  status: Activity,
  map: MapIcon,
  partner: Handshake,
  privacy: ShieldCheck,
  imprint: FileText,
};

const normalize = (p: string) => {
  if (!p) return '/';
  let v = p;
  v = v.replace(/\.html$/i, '');
  if (v.length > 1 && v.endsWith('/')) v = v.slice(0, -1);
  return v || '/';
};

const pathname = Astro.url?.pathname || '/';
const current = normalize(pathname);

const isActive = (href: string, external?: boolean) => {
  if (external) return false;
  const h = normalize(hrefFor(href));
  if (h === '/') return current === '/' || current === '';
  return h === current;
};

const linkClassDesktop = (active: boolean) => `site-nav-link ${active ? 'is-active' : ''}`.trim();

const linkClassMega = (active: boolean) =>
  `group flex min-w-0 items-center gap-2 rounded-md px-2 py-2 text-[13px] leading-tight font-medium transition-colors md:gap-3 md:text-sm ${
    active ? 'bg-accent/10 text-fg' : 'text-fg/90 hover:bg-surface/45 hover:text-fg'
  }`;
---

<header
  class="site-nav-shell sticky top-0 z-50 [--site-nav-offset:calc(4.25rem+env(safe-area-inset-top))]"
  data-site-nav
>
  <div class="mx-auto max-w-6xl px-4 pt-[env(safe-area-inset-top)]">
    <div class="site-nav-row flex items-center justify-between gap-4">
      <a href={appRoutes.home} class="flex items-center gap-3" aria-label="Minecraft Gilde (Start)">
        <img
          src={logoImage.src}
          width="36"
          height="36"
          alt="Minecraft Gilde"
          class="h-9 w-9 object-contain"
          decoding="async"
        />
        <div class="site-brand-copy hidden leading-tight md:block">
          <span class="text-sm font-semibold">Minecraft Gilde</span>
          <div class="text-muted text-xs">Vanilla SMP - 1.21.x</div>
        </div>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Hauptnavigation">
        {
          NAV_PRIMARY_LINKS.map((item) => {
            const active = isActive(item.href, item.external);

            return (
              <NavItem
                href={item.href}
                external={item.external}
                ariaCurrent={active ? 'page' : undefined}
                class={linkClassDesktop(active)}
              >
                {item.label}
              </NavItem>
            );
          })
        }
      </nav>

      <div class="site-nav-controls relative flex min-w-0 items-center gap-2">
        <IconButton ariaLabel="Theme wechseln" data-theme-toggle>
          <Sun size={18} class="hidden" data-theme-icon="light" />
          <Moon size={18} class="hidden" data-theme-icon="dark" />
          <SunMoon size={18} data-theme-icon="system" />
        </IconButton>

        <!-- Discord-Status (Desktop) + Hover-Card -->
        <div class="group relative hidden lg:inline-block">
          <div tabindex="0" aria-label="Discord Status" class="site-discord-link">
            <span class="site-discord-icon" aria-hidden="true">
              <svg viewBox="0 0 127.14 96.36" class="h-5 w-5 fill-current">
                <path
                  d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"
                ></path>
              </svg>
            </span>
            <span class="site-discord-text">
              <span class="mg-discord-members tabular-nums" data-discord-members>-</span>
              <span class="site-discord-label">Mitglieder</span>
            </span>
          </div>

          <div
            class="invisible absolute top-full right-0 left-auto z-50 mt-2 w-[min(15rem,calc(100vw-1.5rem))] translate-y-1 opacity-0 transition-all duration-150 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
          >
            <div class="glass-strong rounded-[var(--radius)] p-4 shadow-lg">
              <div class="text-sm font-semibold">Discord Status</div>
              <div class="mt-3 flex items-center justify-between text-sm">
                <span class="text-muted">Mitglieder:</span>
                <span class="font-semibold tabular-nums" data-discord-members>-</span>
              </div>
              <div class="mt-3">
                <NavItem
                  href={NAV_DISCORD_LINK.href}
                  external
                  class="text-accent hover:text-accent2 hover:decoration-accent/60 text-sm font-semibold whitespace-nowrap underline decoration-transparent underline-offset-4 transition-colors"
                >
                  Discord beitreten
                </NavItem>
              </div>
            </div>
          </div>
        </div>

        <IconButton
          ariaLabel="Menü öffnen"
          aria-controls="nav-panel"
          aria-expanded="false"
          data-nav-toggle
        >
          <Menu size={20} data-icon-open />
          <X size={20} class="hidden" data-icon-close />
        </IconButton>

        <div id="nav-panel" class="absolute top-full right-0 z-50 hidden" data-nav-panel>
          <!-- Mobile-Overlay -->
          <div
            class="bg-bg/90 supports-[backdrop-filter]:bg-bg/70 fixed top-[var(--site-nav-offset)] right-0 bottom-0 left-0 z-40 hidden backdrop-blur-[64px] backdrop-contrast-90 backdrop-saturate-150 md:hidden dark:bg-black/80 dark:supports-[backdrop-filter]:bg-black/55"
            data-nav-overlay
          >
          </div>

          <div
            class="fixed top-[var(--site-nav-offset)] right-0 left-0 z-50 px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom))] md:absolute md:top-2 md:right-0 md:left-auto md:w-[min(23rem,calc(100vw-2rem))] md:px-0 md:pb-0"
          >
            <div
              class="border-border/80 bg-surface-solid/98 supports-[backdrop-filter]:bg-surface-solid/95 md:bg-surface-solid/99 md:supports-[backdrop-filter]:bg-surface-solid/97 relative overflow-hidden rounded-[var(--radius)] border shadow-lg supports-[backdrop-filter]:backdrop-blur-xl supports-[backdrop-filter]:backdrop-saturate-150 md:shadow-2xl md:supports-[backdrop-filter]:backdrop-blur-[56px] md:supports-[backdrop-filter]:backdrop-brightness-90 md:supports-[backdrop-filter]:backdrop-contrast-75 md:supports-[backdrop-filter]:backdrop-saturate-200"
            >
              <div
                class="max-h-[calc(100dvh-6rem-env(safe-area-inset-top)-env(safe-area-inset-bottom))] overflow-y-auto overscroll-contain px-4 py-4 sm:px-5 md:max-h-[calc(100dvh-9rem)] md:p-3"
              >
                <div class="space-y-4">
                  {
                    NAV_MEGA_MENU_SECTIONS.map((section, sectionIndex) => (
                      <section
                        class:list={[
                          sectionIndex > 0 ? 'border-border/70 mt-4 border-t pt-4' : undefined,
                        ]}
                      >
                        <h2 class="text-muted text-[11px] font-semibold tracking-[0.14em] uppercase">
                          {section.title}
                        </h2>
                        <div class="mt-2 grid grid-cols-2 gap-0.5">
                          {section.items.map((item) => {
                            const Icon = MENU_ICONS[item.icon];
                            const active = isActive(item.href, item.external);

                            return (
                              <NavItem
                                href={item.href}
                                external={item.external}
                                ariaCurrent={active ? 'page' : undefined}
                                showExternalHint={false}
                                class={linkClassMega(active)}
                              >
                                <span
                                  class:list={[
                                    'inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md transition-colors md:h-7 md:w-7',
                                    active ? 'text-accent' : 'text-muted group-hover:text-accent',
                                  ]}
                                >
                                  <Icon size={14} />
                                </span>
                                <span class="inline-flex min-w-0 items-center gap-1.5">
                                  <span class="truncate">{item.label}</span>
                                  {item.external ? (
                                    <ExternalLink size={13} class="shrink-0 opacity-70" />
                                  ) : null}
                                </span>
                                {item.external ? <span class="sr-only"> (extern)</span> : null}
                              </NavItem>
                            );
                          })}
                        </div>
                      </section>
                    ))
                  }
                </div>

                <div class="bg-border/70 mt-4 h-px"></div>

                <div
                  class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
                >
                  <Button
                    href={NAV_DISCORD_LINK.href}
                    external
                    variant="primary"
                    class="w-full sm:w-auto"
                  >
                    <span class="inline-flex items-center gap-2">
                      Discord beitreten
                      <ExternalLink size={16} />
                    </span>
                  </Button>

                  <p class="text-muted text-[11px] sm:text-xs">
                    <span class="text-fg tabular-nums" data-discord-members>-</span> Mitglieder auf Discord
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

---
export type CardVariant = 'glass' | 'solid';

export interface Props {
  variant?: CardVariant;
  class?: string;
}

// Solid ist der Standard fuer Content; Glass nur gezielt fuer Hero/Modal/Nav/Overlays einsetzen.
const { variant = 'solid', class: className = '' } = Astro.props as Props;

const variants: Record<CardVariant, string> = {
  solid: 'bg-surface-solid border border-border shadow-sm',
  glass: 'mg-glass shadow-sm',
};
---

<div class={`${variants[variant]} rounded-[var(--radius)] ${className}`.trim()}>
  <slot />
</div>

---
import { ROLE_LABELS, type RoleKey } from '../../data/roles';

export interface Props {
  role: RoleKey;
  class?: string;
}

const { role, class: className = '' } = Astro.props as Props;

const label = ROLE_LABELS[role];
const roleClass = `mg-role-badge--${role}`;
---

<span
  class={`inline-flex items-center gap-2 rounded-full border border-border bg-surface px-2.5 py-1 text-xs font-medium text-fg backdrop-blur-md ${className}`.trim()}
>
  <span
    class={`relative inline-flex h-2.5 w-2.5 items-center justify-center ${roleClass}`}
    aria-hidden="true"
  >
    <span class="mg-role-badge__halo absolute inset-0 rounded-full"></span>
    <span class="mg-role-badge__dot h-1.5 w-1.5 rounded-full"></span>
  </span>
  <span class="leading-none">{label}</span>
</span>

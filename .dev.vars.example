STATS_DB_HOST=127.0.0.1
STATS_DB_PORT=3306
STATS_DB_NAME=stats
STATS_DB_USER=stats_user
STATS_DB_PASS=bitte_aendern
STATS_DB_CHARSET=utf8mb4
# Hinweis: Für Wrangler allein in .dev.vars nicht ausreichend.
# Entweder vor `npm run dev:worker` als Shell-Umgebungsvariable setzen
# oder `localConnectionString` lokal in `wrangler.toml` nutzen.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=mysql://STATS_DB_USER:STATS_DB_PASS@STATS_DB_HOST:STATS_DB_PORT/STATS_DB_NAME

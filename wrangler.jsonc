{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minecraft-gilde-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },

  // Hyperdrive Binding (empfohlen fuer Produktionszugriff auf MariaDB).
  // Wenn gesetzt, hat HYPERDRIVE Vorrang vor STATS_DB_HOST/STATS_DB_PORT.
  // Fuer lokale Entwicklung keine echten Zugangsdaten ins Repo schreiben.
  // Statt `localConnectionString` besser die Umgebungsvariable
  // `CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE` setzen.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1957f1427ada4516aab63e6664f0ef0c",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minecraft-gilde-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },

  // Hyperdrive Binding (empfohlen fuer MariaDB-Zugriff im Worker).
  // Wenn gesetzt, hat HYPERDRIVE Vorrang vor STATS_DB_HOST/STATS_DB_PORT.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a3d449533ea94a41b307eef65a199162",
      // Platzhalter nur fuer lokale Hyperdrive-Emulation (z. B. Build/Dev mit workerd).
      // Keine produktiven Zugangsdaten hinterlegen; Deploy nutzt weiterhin die echte Hyperdrive-ID.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres",
    },
  ],
}
